rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isStudent(studentId) {
      return signedIn() && request.auth.uid == studentId;
    }
    function isCoach() {
      return signedIn()
        && exists(/databases/$(database)/documents/coaches/$(request.auth.uid));
    }
    function isAssignedCoach(studentId) {
      return isCoach()
        && get(/databases/$(database)/documents/students/$(studentId)).data.coachUid == request.auth.uid;
    }
    function canAccessStudent(studentId) {
      return isStudent(studentId) || isAssignedCoach(studentId);
    }
    function validTechnicalIssueFields(ownerId, reporterRole) {
      return request.resource.data.keys().hasAll([
          'schemaVersion', 'ownerUid', 'reporterUid', 'reporterRole', 'operation', 'operationLabel',
          'errorCode', 'errorName', 'appVersion', 'supportCode', 'fingerprint', 'page', 'device',
          'online', 'saveState', 'referenceId', 'priority', 'status', 'lastEventId', 'occurrences',
          'firstSeenAt', 'lastSeenAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'schemaVersion', 'ownerUid', 'reporterUid', 'reporterRole', 'operation', 'operationLabel',
          'errorCode', 'errorName', 'appVersion', 'supportCode', 'fingerprint', 'page', 'device',
          'online', 'saveState', 'referenceId', 'priority', 'status', 'lastEventId', 'occurrences',
          'firstSeenAt', 'lastSeenAt', 'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.ownerUid == ownerId
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reporterRole == reporterRole
        && request.resource.data.operation is string
        && request.resource.data.operation.size() > 0
        && request.resource.data.operation.size() <= 60
        && request.resource.data.operationLabel is string
        && request.resource.data.operationLabel.size() <= 120
        && request.resource.data.errorCode is string
        && request.resource.data.errorCode.size() <= 80
        && request.resource.data.errorName is string
        && request.resource.data.errorName.size() <= 60
        && request.resource.data.appVersion is string
        && request.resource.data.appVersion.size() <= 80
        && request.resource.data.supportCode is string
        && request.resource.data.supportCode.size() > 0
        && request.resource.data.supportCode.size() <= 80
        && request.resource.data.fingerprint is string
        && request.resource.data.fingerprint.size() <= 20
        && request.resource.data.page is string
        && request.resource.data.page.size() <= 180
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 160
        && request.resource.data.online is bool
        && request.resource.data.saveState in ['saved', 'not-saved', 'draft-kept', 'unknown']
        && request.resource.data.referenceId is string
        && request.resource.data.referenceId.size() <= 180
        && request.resource.data.priority in ['normal', 'high']
        && request.resource.data.status == 'open'
        && request.resource.data.lastEventId is string
        && request.resource.data.lastEventId.size() > 0
        && request.resource.data.lastEventId.size() <= 180
        && request.resource.data.occurrences is int
        && request.resource.data.occurrences > 0;
    }
    function validTechnicalIssueCreate(ownerId, reporterRole) {
      return validTechnicalIssueFields(ownerId, reporterRole)
        && request.resource.data.occurrences == 1
        && request.resource.data.firstSeenAt == request.time
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function validTechnicalIssueUpdate(ownerId, reporterRole) {
      return validTechnicalIssueFields(ownerId, reporterRole)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'occurrences', 'lastEventId', 'page', 'device', 'online', 'saveState',
          'referenceId', 'lastSeenAt', 'updatedAt'
        ])
        && request.resource.data.occurrences == resource.data.occurrences + 1
        && request.resource.data.lastEventId != resource.data.lastEventId
        && request.resource.data.firstSeenAt == resource.data.firstSeenAt
        && request.resource.data.lastSeenAt == request.time
        && request.resource.data.updatedAt == request.time;
    }
    function validClientCategory(value) {
      return value in ['gym', 'freelance', 'online'];
    }
    function validStudentProgramAudit(studentId) {
      let sessionPath = /databases/$(database)/documents/students/$(studentId)/sessions/$(request.resource.data.sourceSessionId);
      return request.resource.data.sourceSessionId is string
        && request.resource.data.sourceSessionId.size() > 0
        && request.resource.data.studentEditedAt == request.time
        && request.resource.data.updatedAt == request.time
        && exists(sessionPath)
        && get(sessionPath).data.studentUid == studentId
        && get(sessionPath).data.performedExerciseIds is list
        && get(sessionPath).data.performedExerciseIds.hasAny([request.resource.data.exerciseId]);
    }
    function validExistingAssignmentAudit(studentId, assignmentId) {
      let sessionPath = /databases/$(database)/documents/students/$(studentId)/sessions/$(request.resource.data.sourceSessionId);
      return validStudentProgramAudit(studentId)
        && get(sessionPath).data.performedAssignmentIds is list
        && get(sessionPath).data.performedAssignmentIds.hasAny([assignmentId]);
    }
    function validProgressionStateUpdate(studentId, exerciseId) {
      let sessionId = request.resource.data.get('state', {}).get('lastSessionId', '');
      let sessionPath = /databases/$(database)/documents/students/$(studentId)/sessions/$(sessionId);
      return request.resource.data.updatedAt == request.time
        && request.resource.data.state is map
        && sessionId is string
        && sessionId.size() > 0
        && existsAfter(sessionPath)
        && getAfter(sessionPath).data.studentUid == studentId
        && getAfter(sessionPath).data.performedExerciseIds is list
        && getAfter(sessionPath).data.performedExerciseIds.hasAny([exerciseId]);
    }
    function validSessionCreate(studentId) {
      return request.resource.data.keys().hasAll([
          'studentUid', 'dayLabel', 'performedAt', 'clientNote', 'coachNote',
          'durationSeconds', 'loggedAt', 'performedAssignmentIds',
          'performedExerciseIds', 'exerciseLogs'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'dayLabel', 'performedAt', 'clientNote', 'coachNote',
          'durationSeconds', 'loggedAt', 'performedAssignmentIds',
          'performedExerciseIds', 'exerciseLogs', 'completionContext'
        ])
        && request.resource.data.studentUid == studentId
        && request.resource.data.dayLabel is string
        && request.resource.data.dayLabel.size() > 0
        && request.resource.data.performedAt is timestamp
        && request.resource.data.clientNote is string
        && request.resource.data.coachNote == ''
        && request.resource.data.durationSeconds is number
        && request.resource.data.durationSeconds >= 0
        && request.resource.data.loggedAt == request.time
        && request.resource.data.performedAssignmentIds is list
        && request.resource.data.performedExerciseIds is list
        && request.resource.data.exerciseLogs is list
        && request.resource.data.exerciseLogs.size() > 0
        && request.resource.data.get('completionContext', {}) is map;
    }
    function validExerciseNoteCreate(studentId) {
      return request.resource.data.keys().hasAll([
          'studentUid', 'sessionId', 'sessionLabel', 'sessionExerciseId', 'assignmentId',
          'exerciseId', 'exerciseName', 'authorUid', 'authorRole', 'authorName',
          'visibility', 'replyToNoteId', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'sessionId', 'sessionLabel', 'sessionExerciseId', 'assignmentId',
          'exerciseId', 'exerciseName', 'authorUid', 'authorRole', 'authorName',
          'visibility', 'replyToNoteId', 'body', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.studentUid == studentId
        && request.resource.data.sessionId is string
        && request.resource.data.sessionId.size() > 0
        && request.resource.data.sessionId.size() <= 180
        && request.resource.data.sessionLabel is string
        && request.resource.data.sessionLabel.size() <= 120
        && request.resource.data.sessionExerciseId is string
        && request.resource.data.sessionExerciseId.size() <= 180
        && request.resource.data.assignmentId is string
        && request.resource.data.assignmentId.size() <= 180
        && request.resource.data.exerciseId is string
        && request.resource.data.exerciseId.size() > 0
        && request.resource.data.exerciseId.size() <= 180
        && request.resource.data.exerciseName is string
        && request.resource.data.exerciseName.size() <= 180
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() <= 120
        && request.resource.data.visibility in ['private', 'shared']
        && request.resource.data.replyToNoteId is string
        && request.resource.data.replyToNoteId.size() <= 180
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && ((isStudent(studentId)
            && request.resource.data.authorRole == 'student'
            && request.resource.data.visibility == 'shared')
          || (isAssignedCoach(studentId)
            && request.resource.data.authorRole == 'coach'));
    }
    function validStudentProgramPhase(studentId) {
      let phaseId = request.resource.data.get('phaseId', null);
      return phaseId == null
        || (phaseId is string
          && exists(/databases/$(database)/documents/students/$(studentId)/phases/$(phaseId))
          && get(/databases/$(database)/documents/students/$(studentId)/phases/$(phaseId)).data.status == 'active');
    }
    function validLockedPhaseReview(studentId) {
      return request.resource.data.keys().hasAll([
          'studentUid', 'phaseId', 'activationRevision', 'phaseName', 'status', 'schemaVersion',
          'snapshot', 'lockedBy', 'lockedAt', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'studentUid', 'phaseId', 'activationRevision', 'phaseName', 'status', 'schemaVersion',
          'snapshot', 'lockedBy', 'lockedAt', 'createdAt'
        ])
        && request.resource.data.studentUid == studentId
        && request.resource.data.phaseId is string
        && request.resource.data.phaseId.size() > 0
        && request.resource.data.activationRevision is int
        && request.resource.data.activationRevision > 0
        && request.resource.data.phaseName is string
        && request.resource.data.phaseName.size() <= 180
        && request.resource.data.status == 'locked'
        && request.resource.data.schemaVersion == 1
        && request.resource.data.snapshot is map
        && request.resource.data.snapshot.get('status', '') == 'locked'
        && request.resource.data.snapshot.get('schemaVersion', 0) == 1
        && request.resource.data.snapshot.get('phase', {}) is map
        && request.resource.data.snapshot.phase.get('id', '') == request.resource.data.phaseId
        && request.resource.data.snapshot.phase.get('activationRevision', 0) == request.resource.data.activationRevision
        && request.resource.data.snapshot.get('coachReflection', {}) is map
        && request.resource.data.snapshot.coachReflection.get('workedWell', '') is string
        && request.resource.data.snapshot.coachReflection.get('workedWell', '').size() > 0
        && request.resource.data.snapshot.coachReflection.get('needsChange', '') is string
        && request.resource.data.snapshot.coachReflection.get('needsChange', '').size() > 0
        && request.resource.data.snapshot.coachReflection.get('nextCycleDecision', '') is string
        && request.resource.data.snapshot.coachReflection.get('nextCycleDecision', '').size() > 0
        && request.resource.data.lockedBy == request.auth.uid
        && request.resource.data.lockedAt == request.time
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/students/$(studentId)/phases/$(request.resource.data.phaseId))
        && get(/databases/$(database)/documents/students/$(studentId)/phases/$(request.resource.data.phaseId)).data.status == 'active'
        && get(/databases/$(database)/documents/students/$(studentId)/phases/$(request.resource.data.phaseId)).data.get('activationRevision', 1) == request.resource.data.activationRevision;
    }
    match /coaches/{coachId} {
      allow read, update: if signedIn() && request.auth.uid == coachId;
      allow create, delete: if false;
      match /technicalIssues/{issueId} {
        allow read: if signedIn() && request.auth.uid == coachId;
        allow create: if signedIn() && request.auth.uid == coachId
          && validTechnicalIssueCreate(coachId, 'coach');
        allow update: if signedIn() && request.auth.uid == coachId
          && validTechnicalIssueUpdate(coachId, 'coach');
        allow delete: if false;
      }
      match /programTemplates/{templateId} {
        allow read, write: if signedIn() && request.auth.uid == coachId;
      }
      match /notifications/{notificationId} {
        allow read: if signedIn() && request.auth.uid == coachId;
        allow update: if signedIn()
          && request.auth.uid == coachId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt'])
          && request.resource.data.readAt == request.time;
        allow create, delete: if false;
      }
      match /notificationDevices/{deviceId} {
        allow read, delete: if signedIn() && request.auth.uid == coachId;
        allow create: if signedIn()
          && request.auth.uid == coachId
          && request.resource.data.keys().hasAll(['token', 'enabled', 'platform', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['token', 'enabled', 'platform', 'createdAt', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.enabled is bool
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 300
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == request.time;
        allow update: if signedIn()
          && request.auth.uid == coachId
          && request.resource.data.keys().hasAll(['token', 'enabled', 'platform', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['token', 'enabled', 'platform', 'createdAt', 'updatedAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.token.size() <= 4096
          && request.resource.data.enabled is bool
          && request.resource.data.platform is string
          && request.resource.data.platform.size() <= 300
          && request.resource.data.updatedAt == request.time
          && request.resource.data.createdAt == resource.data.createdAt;
      }
      match /reviewAlerts/{alertId} {
        allow read: if signedIn() && request.auth.uid == coachId;
        allow create, delete: if false;
        allow update: if signedIn()
          && request.auth.uid == coachId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'action', 'coachNote', 'reviewDate', 'handledBy',
            'handledAt', 'updatedAt', 'version'
          ])
          && request.resource.data.status in ['open', 'acknowledged', 'in_progress', 'resolved']
          && request.resource.data.action in ['viewed', 'adjust-program', 'contact-client', 'complete', 'reopen']
          && request.resource.data.coachNote is string
          && request.resource.data.coachNote.size() <= 2000
          && (request.resource.data.reviewDate == null || request.resource.data.reviewDate is string)
          && request.resource.data.handledBy == request.auth.uid
          && request.resource.data.handledAt == request.time
          && request.resource.data.updatedAt == request.time
          && request.resource.data.version == resource.data.version + 1;
      }
    }
    match /students/{studentId} {
      // Use resource.data here so listMyStudents() can authorize the coach's query.
      allow read: if isStudent(studentId) || (isCoach() && resource.data.coachUid == request.auth.uid);
      allow create: if isCoach()
        && request.resource.data.coachUid == request.auth.uid
        && validClientCategory(request.resource.data.clientCategory);
      allow update: if (isAssignedCoach(studentId)
          && validClientCategory(request.resource.data.clientCategory))
        || (isStudent(studentId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'goal', 'notes', 'unitPref', 'localePref', 'updatedAt']));
      allow delete: if isAssignedCoach(studentId);
      match /technicalIssues/{issueId} {
        allow read: if canAccessStudent(studentId);
        allow create: if isStudent(studentId)
          && validTechnicalIssueCreate(studentId, 'student');
        allow update: if isStudent(studentId)
          && validTechnicalIssueUpdate(studentId, 'student');
        allow delete: if false;
      }
      match /assignments/{assignmentId} {
        allow read: if canAccessStudent(studentId);
        allow create: if isAssignedCoach(studentId)
          || (isStudent(studentId)
            && request.resource.data.keys().hasAll([
              'exerciseId', 'exerciseNameSnapshot', 'dayLabel', 'orderInDay', 'scheme',
              'schemeParams', 'state', 'phaseId', 'active', 'studentCreated',
              'sourceSessionId', 'studentEditedAt', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'exerciseId', 'exerciseNameSnapshot', 'dayLabel', 'orderInDay', 'scheme',
              'schemeParams', 'state', 'phaseId', 'note', 'volumeConfig', 'active',
              'studentCreated', 'sourceSessionId', 'studentEditedAt', 'createdAt', 'updatedAt'
            ])
            && request.resource.data.exerciseId is string
            && request.resource.data.dayLabel is string
            && request.resource.data.orderInDay is number
            && request.resource.data.active == true
            && request.resource.data.studentCreated == true
            && request.resource.data.createdAt == request.time
            && validStudentProgramAudit(studentId)
            && validStudentProgramPhase(studentId));
        allow delete: if isAssignedCoach(studentId);
        allow update: if isAssignedCoach(studentId)
          || (isStudent(studentId)
            && ((request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['state', 'updatedAt'])
                && validProgressionStateUpdate(studentId, resource.data.exerciseId)
              ) || (validExistingAssignmentAudit(studentId, assignmentId)
                && request.resource.data.dayLabel == resource.data.dayLabel
                && request.resource.data.orderInDay == resource.data.orderInDay
                && request.resource.data.get('phaseId', null) == resource.data.get('phaseId', null)
                && request.resource.data.get('note', '') == resource.data.get('note', '')
                && ((request.resource.data.active == false
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'active', 'sourceSessionId', 'studentEditedAt', 'updatedAt'
                    ]))
                  || (request.resource.data.active == resource.data.active
                    && request.resource.data.exerciseId is string
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'exerciseId', 'exerciseNameSnapshot', 'scheme', 'schemeParams', 'state',
                      'volumeConfig', 'sourceSessionId', 'studentEditedAt', 'updatedAt'
                    ]))))));
      }
      match /nutritionProfile/{profileId} {
        allow read: if canAccessStudent(studentId);
        allow write: if isAssignedCoach(studentId);
      }
      match /phases/{phaseId} {
        allow read: if canAccessStudent(studentId);
        allow write: if isAssignedCoach(studentId);
      }
      match /phaseReviews/{reviewId} {
        allow read: if isAssignedCoach(studentId)
          || (isStudent(studentId) && resource.data.status == 'locked');
        allow create: if isAssignedCoach(studentId)
          && validLockedPhaseReview(studentId);
        allow update, delete: if false;
        match /appendices/{appendixId} {
          allow read: if isAssignedCoach(studentId)
            || (isStudent(studentId)
               && get(/databases/$(database)/documents/students/$(studentId)/phaseReviews/$(reviewId)).data.status == 'locked');
          allow create: if isAssignedCoach(studentId)
            && exists(/databases/$(database)/documents/students/$(studentId)/phaseReviews/$(reviewId))
            && get(/databases/$(database)/documents/students/$(studentId)/phaseReviews/$(reviewId)).data.status == 'locked'
            && request.resource.data.keys().hasAll([
              'studentUid', 'phaseId', 'reviewId', 'body', 'reason', 'createdBy', 'createdAt'
            ])
            && request.resource.data.keys().hasOnly([
              'studentUid', 'phaseId', 'reviewId', 'body', 'reason', 'createdBy', 'createdAt'
            ])
            && request.resource.data.studentUid == studentId
            && request.resource.data.phaseId == get(/databases/$(database)/documents/students/$(studentId)/phaseReviews/$(reviewId)).data.phaseId
            && request.resource.data.reviewId == reviewId
            && request.resource.data.body is string
            && request.resource.data.body.size() > 0
            && request.resource.data.body.size() <= 4000
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.reason.size() <= 1000
            && request.resource.data.createdBy == request.auth.uid
            && request.resource.data.createdAt == request.time;
          allow update, delete: if false;
        }
      }
      match /deloadDecisions/{decisionId} {
        allow read: if canAccessStudent(studentId);
        allow create: if isAssignedCoach(studentId)
          && request.resource.data.keys().hasAll([
            'studentUid', 'phaseId', 'activationRevision', 'phaseName', 'action', 'reason',
            'scheduledDate', 'recommendationSnapshot', 'createdBy', 'createdAt'
          ])
          && request.resource.data.keys().hasOnly([
            'studentUid', 'phaseId', 'activationRevision', 'phaseName', 'action', 'reason',
            'scheduledDate', 'recommendationSnapshot', 'createdBy', 'createdAt'
          ])
          && request.resource.data.studentUid == studentId
          && request.resource.data.phaseId is string
          && request.resource.data.phaseId.size() > 0
          && request.resource.data.activationRevision is int
          && request.resource.data.activationRevision > 0
          && request.resource.data.phaseName is string
          && request.resource.data.action in ['no-deload', 'schedule', 'start', 'complete', 'dismiss']
          && request.resource.data.reason is string
          && request.resource.data.reason.size() > 0
          && request.resource.data.reason.size() <= 2000
          && request.resource.data.scheduledDate is string
          && request.resource.data.recommendationSnapshot is map
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time
          && exists(/databases/$(database)/documents/students/$(studentId)/phases/$(request.resource.data.phaseId))
          && get(/databases/$(database)/documents/students/$(studentId)/phases/$(request.resource.data.phaseId)).data.status == 'active'
          && get(/databases/$(database)/documents/students/$(studentId)/phases/$(request.resource.data.phaseId)).data.get('activationRevision', 1) == request.resource.data.activationRevision;
        allow update, delete: if false;
      }
      match /programMeta/{metaId} {
        allow read: if canAccessStudent(studentId);
        allow write: if isAssignedCoach(studentId);
      }
      match /sessions/{sessionId} {
        allow read: if canAccessStudent(studentId);
        allow create: if canAccessStudent(studentId)
          && validSessionCreate(studentId);
        allow update: if isAssignedCoach(studentId)
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['coachNote', 'updatedAt']);
        allow delete: if isAssignedCoach(studentId);
      }
      match /coachingAlerts/{alertId} {
        allow read: if canAccessStudent(studentId);
        allow create: if isStudent(studentId)
          && request.resource.data.studentUid == studentId
          && request.resource.data.status == 'open'
          && request.resource.data.type in ['exercise-pain', 'general-joint-pain']
          && request.resource.data.lastDetectedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if (isStudent(studentId)
            && request.resource.data.studentUid == studentId
            && request.resource.data.type == resource.data.type
            && request.resource.data.get('assignmentId', null) == resource.data.get('assignmentId', null)
            && request.resource.data.status == 'open'
            && request.resource.data.lastDetectedAt == request.time
            && request.resource.data.updatedAt == request.time)
          || (isAssignedCoach(studentId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'progressionHeld', 'blocksVolumeIncrease',
              'acknowledgedAt', 'acknowledgedBy', 'resolvedAt', 'resolvedBy',
              'resolutionNote', 'updatedAt'
            ])
            && request.resource.data.status in ['acknowledged', 'holding', 'resolved']
            && request.resource.data.updatedAt == request.time);
        allow delete: if false;
      }
      match /coachingAlertEvents/{eventId} {
        allow read: if canAccessStudent(studentId);
        allow create: if isStudent(studentId)
          && request.resource.data.studentUid == studentId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
      match /progressionAudits/{auditId} {
        allow read: if canAccessStudent(studentId);
        allow create: if (isStudent(studentId)
            && request.resource.data.studentUid == studentId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.actorRole == 'engine'
            && request.resource.data.source in ['engine', 'safety']
            && request.resource.data.sessionId is string
            && existsAfter(/databases/$(database)/documents/students/$(studentId)/sessions/$(request.resource.data.sessionId))
            && request.resource.data.createdAt == request.time)
          || (isAssignedCoach(studentId)
            && request.resource.data.studentUid == studentId
            && request.resource.data.actorUid == request.auth.uid
            && request.resource.data.actorRole == 'coach'
            && request.resource.data.source in ['coach-manual', 'safety-resolved']
            && request.resource.data.reason is string
            && request.resource.data.reason.size() > 0
            && request.resource.data.createdAt == request.time);
        allow update, delete: if false;
      }
      match /exerciseNotes/{noteId} {
        allow read: if isAssignedCoach(studentId)
          || (isStudent(studentId) && resource.data.visibility == 'shared');
        allow create: if canAccessStudent(studentId) && validExerciseNoteCreate(studentId);
        // Journal entries are immutable. Replies are separate entries so the original
        // feedback, author and timestamp can never be silently replaced.
        allow update, delete: if false;
      }
      match /workoutDrafts/{draftId} {
        allow read: if canAccessStudent(studentId);
        allow create, update: if isStudent(studentId)
          && draftId == 'active'
          && request.resource.data.studentUid == studentId
          && request.resource.data.day is string
          && request.resource.data.sessionId is string
          && request.resource.data.exercises is list
          && request.resource.data.revision is int
          && request.resource.data.updatedAt == request.time;
        allow delete: if isStudent(studentId) && draftId == 'active';
      }
      match /extraExerciseStates/{exerciseId} {
        allow read: if canAccessStudent(studentId);
        allow create: if isAssignedCoach(studentId)
          || (isStudent(studentId)
            && request.resource.data.keys().hasAll([
              'exerciseId', 'exerciseNameSnapshot', 'scheme', 'schemeParams', 'state', 'updatedAt'
            ])
            && request.resource.data.keys().hasOnly([
              'exerciseId', 'exerciseNameSnapshot', 'scheme', 'schemeParams', 'state', 'updatedAt'
            ])
            && request.resource.data.exerciseId == exerciseId
            && validProgressionStateUpdate(studentId, exerciseId));
        allow update: if isAssignedCoach(studentId)
          || (isStudent(studentId)
          && resource.data.exerciseId == exerciseId
          && request.resource.data.exerciseId == exerciseId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt'])
          && validProgressionStateUpdate(studentId, exerciseId));
        allow delete: if isAssignedCoach(studentId);
      }
      match /bodyWeightLogs/{logId} {
        allow read, create, update, delete: if canAccessStudent(studentId);
      }
      match /progressPhotos/{photoId} {
        allow read, create, delete: if canAccessStudent(studentId);
        allow update: if isAssignedCoach(studentId)
          || (isStudent(studentId)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['note', 'takenAt']));
      }
      match /nutritionDays/{dayId} {
        allow read, create, update: if canAccessStudent(studentId);
        allow delete: if isAssignedCoach(studentId);
      }
      match /checkIns/{checkInId} {
        allow read, create: if canAccessStudent(studentId);
        allow update: if isAssignedCoach(studentId)
          || (isStudent(studentId)
            && resource.data.status != 'reviewed'
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['weight', 'energy', 'hunger', 'sleepHours', 'adherence', 'note', 'submittedAt']));
        allow delete: if isAssignedCoach(studentId);
      }
      match /messages/{messageId} {
        allow read: if canAccessStudent(studentId);
        allow create: if canAccessStudent(studentId)
          && request.resource.data.senderUid == request.auth.uid
          && ((request.resource.data.senderRole == 'student' && isStudent(studentId))
            || (request.resource.data.senderRole == 'coach' && isAssignedCoach(studentId)));
        allow update: if false;
        allow delete: if isAssignedCoach(studentId)
          || (isStudent(studentId) && resource.data.senderUid == request.auth.uid);
      }

      // Students can only see the active/published plan; drafts stay coach-only.
      match /nutritionPlans/{planId} {
        allow read: if isAssignedCoach(studentId)
          || (isStudent(studentId)
            && (planId == 'current' || resource.data.status == 'published'));
        allow create, update, delete: if isAssignedCoach(studentId);
      }

      // One student-authored adherence report per calendar day.
      match /nutritionCheckins/{checkInId} {
        allow read: if canAccessStudent(studentId);
        allow create, update: if isStudent(studentId);
        allow delete: if isAssignedCoach(studentId);
      }
    }
  }
}
